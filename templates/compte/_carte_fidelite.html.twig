{# Carte de fidélité : solde, progression vers le prochain palier, paliers, expiration, statut. #}
<section class="carte-fidelite" aria-labelledby="titre-carte-fidelite">
    <div class="carte-fidelite__entete">
        <h2 id="titre-carte-fidelite" class="carte-fidelite__titre">Ma fidélité</h2>
        {% if fidelite.fidele %}
            <span class="badge-fidele">Cliente fidèle</span>
        {% endif %}
    </div>

    <p class="carte-fidelite__solde"><strong>{{ fidelite.solde }}</strong> points</p>

    {% if fidelite.prochain %}
        <div class="progression" role="progressbar" aria-valuemin="0" aria-valuemax="{{ fidelite.prochain.seuilPoints }}"
             aria-valuenow="{{ fidelite.solde }}" aria-label="Progression vers {{ fidelite.prochain.nom }}">
            <span class="progression__barre progression__barre--{{ (fidelite.progression / 10)|round(0, 'floor') * 10 }}"></span>
        </div>
        <p class="carte-fidelite__prochain">
            Plus que <strong>{{ fidelite.prochain.seuilPoints - fidelite.solde }} points</strong> pour : {{ fidelite.prochain.nom }}
        </p>
    {% elseif fidelite.paliers is not empty %}
        <p class="carte-fidelite__prochain">Tous les paliers sont atteints : profitez-en à votre prochaine réservation !</p>
    {% endif %}

    <ul class="paliers">
        {% for palier in fidelite.paliers %}
            <li class="palier{{ palier.atteint ? ' palier--atteint' }}">
                <span class="palier__seuil">{{ palier.recompense.seuilPoints }} pts</span>
                <span class="palier__nom">
                    {{ palier.recompense.nom }}
                    <small>
                        {%- if palier.recompense.supplement -%}
                            à utiliser en réservant en ligne avec l'option « {{ palier.recompense.supplement.nom }} »
                        {%- elseif palier.recompense.estUtilisableEnLigne -%}
                            à utiliser en réservant en ligne
                        {%- else -%}
                            à demander au salon
                        {%- endif -%}
                    </small>
                </span>
                <span class="palier__etat">{{ palier.atteint ? 'Disponible' : 'Encore ' ~ palier.manque ~ ' pts' }}</span>
            </li>
        {% endfor %}
    </ul>

    {% set vie = reduction_a_vie(client) %}
    {% if vie.active %}
        <div class="reduction-vie{{ vie.pourcentage > 0 ? ' reduction-vie--obtenue' }}">
            {% if vie.pourcentage > 0 %}
                <p class="reduction-vie__titre"><strong>Statut VIP : −{{ vie.pourcentage }} % à vie</strong> sur toutes vos prestations</p>
                <p>
                    Appliquée d'office quand vous réservez avec votre compte (sauf si vous utilisez une récompense sur le rendez-vous).
                    {% if vie.pourcentage < vie.plafond %}
                        Cette année : <strong>{{ vie.visites }} rendez-vous sur {{ vie.visites_requises }}</strong> pour passer à {{ min(vie.pourcentage + vie.pas, vie.plafond) }} %
                        (bilan le {{ vie.revision|date_fr('d MMMM yyyy') }}).
                    {% else %}
                        Vous avez atteint le niveau maximum. Merci pour votre fidélité !
                    {% endif %}
                </p>
            {% else %}
                <p class="reduction-vie__titre"><strong>Statut VIP, −{{ vie.depart }} % à vie</strong> : cumulez {{ vie.seuil }} points au total</p>
                <div class="progression" role="progressbar" aria-valuemin="0" aria-valuemax="{{ vie.seuil }}" aria-valuenow="{{ min(vie.points, vie.seuil) }}" aria-label="Progression vers le statut VIP">
                    <span class="progression__barre progression__barre--{{ (vie.progression / 10)|round(0, 'floor') * 10 }}"></span>
                </div>
                <p>{{ vie.points }} points gagnés depuis le début (les points utilisés comptent aussi). Le statut ne se perd jamais, et chaque année avec {{ vie.visites_requises }} rendez-vous ajoute +{{ vie.pas }} % (jusqu'à {{ vie.plafond }} %).</p>
            {% endif %}
        </div>
    {% endif %}

    <p class="carte-fidelite__regles">
        {{ fidelite.points_par_euro }} point{{ fidelite.points_par_euro > 1 ? 's' }} par euro payé, crédité{{ fidelite.points_par_euro > 1 ? 's' }} après chaque rendez-vous.
        {% if fidelite.expiration %}
            Vos points sont valables jusqu'au {{ fidelite.expiration|date_fr('d MMMM yyyy') }} : chaque visite prolonge ce délai.
        {% endif %}
        {% if not fidelite.fidele %}
            Statut « Cliente fidèle » après {{ fidelite.visites_requises }} visites en 12 mois ({{ fidelite.visites }} pour l'instant) : réservation ouverte plus longtemps à l'avance.
        {% else %}
            Statut « Cliente fidèle » : vous pouvez réserver plus longtemps à l'avance.
        {% endif %}
        <a href="{{ path('app_compte_fidelite') }}#parrainage">Parrainer une amie</a> ·
        <a href="{{ path('app_conditions') }}#fidelite">Règlement du programme</a>
    </p>
</section>
