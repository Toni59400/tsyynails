{% extends 'layout/public.html.twig' %}

{% block title %}Réserver · {{ salon.nom }}{% endblock %}
{% block description %}Réservez votre rendez-vous chez {{ salon.nom }} en ligne : choisissez votre prestation et votre créneau.{% endblock %}

{% block contenu %}
    <div class="conteneur page">
        {{ include('reservation/_etapes.html.twig', {etape: 1}) }}
        <h1>Quelle prestation souhaitez-vous ?</h1>

        {% if prestations is empty %}
            <p>La réservation en ligne ouvre bientôt. En attendant, <a href="{{ path('app_infos') }}#contact">contactez-moi</a>.</p>
        {% else %}
            <div class="grille-cartes">
                {% for prestation in prestations %}
                    <twig:PrestationCard :prestation="prestation" titre="h2" />
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
