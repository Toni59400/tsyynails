{% extends 'layout/public.html.twig' %}

{% block title %}Vos coordonnées · {{ salon.nom }}{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex">
{% endblock %}

{% block contenu %}
    <div class="conteneur page">
        {{ include('reservation/_etapes.html.twig', {etape: 3}) }}
        <h1>Votre rendez-vous</h1>

        <div class="tunnel-colonnes">
            <div>
                {{ include('reservation/_recap.html.twig', {lignes: lignes_prix, a_payer: a_payer, acompte: acompte}) }}
                <p><a href="{{ path('app_reservation_creneau', {id: prestation.id, jour: debut|date('Y-m-d')}|merge(parametres_choix)) }}">Changer de créneau ou d'option</a></p>
            </div>

            {{ form_start(formulaire, {attr: {class: 'formulaire', novalidate: 'novalidate'}}) }}
                {% if not formulaire.vars.valid %}
                    <div class="alerte alerte--erreur" role="alert">Vérifiez les champs signalés ci-dessous.</div>
                {% endif %}

                {# Erreurs qui ne concernent aucun champ affiché : toujours visibles, jamais d'échec « muet ». #}
                {% if formulaire.vars.errors|length > 0 %}
                    <div class="alerte alerte--erreur" role="alert">
                        <ul>{% for erreur in formulaire.vars.errors %}<li>{{ erreur.message }}</li>{% endfor %}</ul>
                    </div>
                {% endif %}

                {% if cliente %}
                    <h2 class="formulaire__titre">Bonjour {{ cliente.prenom ?: app.user.email }}</h2>
                    {% if formulaire.prenom is defined %}
                        <p class="formulaire__note">Merci de compléter votre fiche (confirmation envoyée à {{ app.user.email }}) :</p>
                        {% for champ in [formulaire.prenom, formulaire.nom, formulaire.telephone] %}
                            <div class="champ{{ champ.vars.valid ? '' : ' champ--erreur' }}">
                                {{ form_label(champ) }}
                                {{ form_widget(champ) }}
                                {{ form_help(champ) }}
                                {{ form_errors(champ) }}
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="formulaire__note">
                            Réservation au nom de {{ cliente.nomComplet }}, confirmation envoyée à {{ app.user.email }}.
                            <a href="{{ path('app_compte_donnees') }}">Modifier</a>
                        </p>
                    {% endif %}

                    <div class="fidelite-tunnel">
                        <p class="fidelite-tunnel__solde">Vous avez <strong>{{ solde }} points</strong>.
                            Ce rendez-vous vous en rapportera environ {{ points_gagnes }}.</p>
                        {% if formulaire.recompense.vars.choices is not empty %}
                            <fieldset class="champ">
                                <legend>{{ form_label(formulaire.recompense) }}</legend>
                                {{ form_widget(formulaire.recompense) }}
                                <p class="champ__aide">La réduction est déduite du prix et de l'acompte. Vos points vous sont rendus si la demande n'aboutit pas.</p>
                            </fieldset>
                        {% else %}
                            {% do formulaire.recompense.setRendered %}
                            <p class="champ__aide"><a href="{{ path('app_compte_fidelite') }}">Voir les paliers de récompenses</a></p>
                        {% endif %}
                    </div>
                {% else %}
                    <h2 class="formulaire__titre">Vos coordonnées</h2>

                    {% if not app.user %}
                        {% set programme = programme_vie() %}
                        <p class="alerte alerte--info">
                            Ce rendez-vous vous rapportera <strong>{{ points_gagnes }} points de fidélité</strong> avec un compte
                            {%- if programme %}, un premier pas vers votre <strong>réduction à vie de −{{ programme.depart }} %</strong> (dès {{ programme.seuil }} points, jusqu'à −{{ programme.plafond }} % ensuite){% endif %}.
                            <a href="{{ path('app_login', {cible: cible_connexion}) }}">Déjà un compte ? Connectez-vous</a>
                        </p>
                    {% endif %}

                    {% for champ in [formulaire.prenom, formulaire.nom, formulaire.telephone, formulaire.email] %}
                        <div class="champ{{ champ.vars.valid ? '' : ' champ--erreur' }}">
                            {{ form_label(champ) }}
                            {{ form_widget(champ) }}
                            {{ form_help(champ) }}
                            {{ form_errors(champ) }}
                        </div>
                    {% endfor %}

                    {% if formulaire.creerCompte is defined %}
                        <div class="creation-compte" data-controller="afficher-si-coche">
                            <div class="champ champ--case">
                                {{ form_widget(formulaire.creerCompte) }}
                                {{ form_label(formulaire.creerCompte) }}
                            </div>
                            <div class="champ{{ formulaire.motDePasse.vars.valid ? '' : ' champ--erreur' }}" data-afficher-si-coche-target="bloc">
                                {{ form_label(formulaire.motDePasse) }}
                                {{ form_widget(formulaire.motDePasse) }}
                                {{ form_help(formulaire.motDePasse) }}
                                {{ form_errors(formulaire.motDePasse) }}
                                <p class="champ__aide">+ des points de bienvenue, et vos rendez-vous au même endroit.</p>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                {% if formulaire.modePaiement is defined %}
                    <fieldset class="champ choix-paiement{{ formulaire.modePaiement.vars.valid ? '' : ' champ--erreur' }}">
                        <legend class="choix-paiement__titre">Comment souhaitez-vous régler ?</legend>
                        {% for choix in formulaire.modePaiement %}
                            <div class="choix-paiement__option">
                                {{ form_widget(choix) }}
                                {{ form_label(choix) }}
                            </div>
                        {% endfor %}
                        {{ form_errors(formulaire.modePaiement) }}
                    </fieldset>
                {% elseif modes_paiement == ['especes'] %}
                    <p class="alerte alerte--info">Aucun acompte en ligne : vous réglez la totalité <strong>en espèces le jour du rendez-vous</strong>. Votre demande est confirmée par email dès que je la valide.</p>
                {% endif %}

                <div class="champ champ--case{{ formulaire.accepteConditions.vars.valid ? '' : ' champ--erreur' }}">
                    {{ form_widget(formulaire.accepteConditions) }}
                    {{ form_label(formulaire.accepteConditions) }}
                    {{ form_errors(formulaire.accepteConditions) }}
                    <p class="champ__aide"><a href="{{ path('app_conditions') }}" target="_blank" rel="noopener">Lire les conditions de réservation</a> (nouvel onglet)</p>
                </div>

                <p class="formulaire__note">
                    Vos coordonnées servent uniquement à gérer votre rendez-vous.
                    <a href="{{ path('app_confidentialite') }}">Politique de confidentialité</a>.
                </p>

                <button type="submit" class="bouton">
                    {%- if modes_paiement == ['especes'] -%}Envoyer ma demande
                    {%- elseif modes_paiement|length > 1 -%}Continuer
                    {%- else -%}Continuer vers l'acompte{%- endif -%}
                </button>
            {{ form_end(formulaire) }}
        </div>
    </div>
{% endblock %}
