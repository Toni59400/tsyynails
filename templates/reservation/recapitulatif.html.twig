{% extends 'layout/public.html.twig' %}

{% block title %}Récapitulatif · {{ salon.nom }}{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex">
{% endblock %}

{% block contenu %}
    <div class="conteneur page">
        {{ include('reservation/_etapes.html.twig', {etape: 3}) }}
        <h1>Votre rendez-vous</h1>

        <dl class="recap">
            <div><dt>Prestation</dt><dd>{{ prestation.nom }}</dd></div>
            <div><dt>Date</dt><dd>{{ debut|date_fr('EEEE d MMMM yyyy')|capitalize }}</dd></div>
            <div><dt>Horaire</dt><dd>{{ debut|heure }} – {{ fin|heure }}</dd></div>
            <div><dt>Prix</dt><dd>{{ prestation.prixCentimes|euros }}</dd></div>
            <div><dt>Acompte</dt><dd>{{ acompte|euros }}, déduit du prix</dd></div>
            <div><dt>Reste à régler au salon</dt><dd>{{ (prestation.prixCentimes - acompte)|euros }}</dd></div>
        </dl>

        <div class="alerte alerte--info" role="note">
            La demande en ligne avec acompte sera bientôt disponible.
            En attendant, <a href="{{ path('app_infos') }}#contact">appelez-moi ou écrivez-moi</a> pour bloquer ce créneau.
        </div>

        <p class="page__actions">
            <a class="bouton bouton--secondaire" href="{{ path('app_reservation_creneau', {id: prestation.id, jour: debut|date('Y-m-d')}) }}">Changer de créneau</a>
        </p>
    </div>
{% endblock %}
