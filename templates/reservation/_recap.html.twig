{#
    Récapitulatif d'un rendez-vous. Variables : debut, fin, lignes (DetailPrix), a_payer (après remises et points), acompte.
#}
<dl class="recap">
    <div><dt>Date</dt><dd>{{ debut|date_fr('EEEE d MMMM yyyy')|capitalize }}</dd></div>
    <div><dt>Horaire</dt><dd>{{ debut|heure }} – {{ fin|heure }}</dd></div>
    {% for ligne in lignes %}
        <div class="{{ ligne.montant < 0 ? 'recap__remise' : '' }}">
            <dt>{{ ligne.libelle }}</dt>
            <dd>{{ ligne.montant < 0 ? '− ' ~ (-ligne.montant)|euros : ligne.montant|euros }}</dd>
        </div>
    {% endfor %}
    <div class="recap__total"><dt>Total</dt><dd>{{ a_payer|euros }}</dd></div>
    {% if acompte > 0 %}
        <div><dt>Acompte</dt><dd>{{ acompte|euros }}, déduit du total</dd></div>
        <div><dt>Reste à régler au salon</dt><dd>{{ (a_payer - acompte)|euros }}</dd></div>
    {% endif %}
</dl>
