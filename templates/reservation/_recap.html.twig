{% set reduction = reduction|default(0) %}
{% set supplement_nom = supplement_nom|default(null) %}
<dl class="recap">
    <div><dt>Prestation</dt><dd>{{ prestation.nom }}</dd></div>
    {% if supplement_nom %}
        <div><dt>Supplément</dt><dd>{{ supplement_nom }} (+ {{ supplement_prix|default(0)|euros }})</dd></div>
    {% endif %}
    <div><dt>Date</dt><dd>{{ debut|date_fr('EEEE d MMMM yyyy')|capitalize }}</dd></div>
    <div><dt>Horaire</dt><dd>{{ debut|heure }} – {{ fin|heure }}</dd></div>
    <div><dt>{{ supplement_nom ? 'Prix total' : 'Prix' }}</dt><dd>{{ prix|euros }}</dd></div>
    {% if reduction > 0 %}
        <div><dt>Réduction fidélité</dt><dd>− {{ reduction|euros }}</dd></div>
    {% endif %}
    <div><dt>Acompte</dt><dd>{{ acompte|euros }}, déduit du prix</dd></div>
    <div><dt>Reste à régler au salon</dt><dd>{{ (prix - reduction - acompte)|euros }}</dd></div>
</dl>
