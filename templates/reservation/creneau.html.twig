{% extends 'layout/public.html.twig' %}

{% block title %}Choisir un créneau · {{ prestation.nom }} · {{ salon.nom }}{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex">
{% endblock %}

{% block contenu %}
    <div class="conteneur page">
        {{ include('reservation/_etapes.html.twig', {etape: 2}) }}
        <h1>Choisissez votre créneau</h1>
        {% if horizon_fidele %}
            <p class="alerte alerte--succes">Cliente fidèle : vous pouvez réserver plus longtemps à l'avance.</p>
        {% endif %}
        {% set duree_totale = prestation.dureeMinutes + (supplement ? supplement.dureeMinutes : 0) %}
        {% set prix_total = prestation.prixCentimes + (supplement ? supplement.prixCentimes : 0) %}
        <p class="recap-court">
            <strong>{{ prestation.nom }}</strong>{% if supplement %} + {{ supplement.nom }}{% endif %}
            · {{ duree_totale|duree }} · {{ prix_total|euros }}
            · <a href="{{ path('app_reservation') }}">changer</a>
        </p>

        {% if supplements is not empty %}
            {# Choix avant le créneau : un supplément allonge le rendez-vous. Sans JavaScript, le bouton recharge les créneaux. #}
            <form method="get" action="{{ path('app_reservation_creneau', {id: prestation.id}) }}" class="options-resa" data-controller="envoi-auto">
                <fieldset>
                    <legend class="options-resa__titre">Envie d'un nail art ?</legend>
                    <div class="options-resa__liste">
                        <label class="option-resa">
                            <input type="radio" name="supplement" value="" {% if not supplement %}checked{% endif %} data-action="envoi-auto#envoyer">
                            <span class="option-resa__nom">Sans supplément</span>
                        </label>
                        {% for s in supplements %}
                            <label class="option-resa">
                                <input type="radio" name="supplement" value="{{ s.id }}" {% if supplement and supplement.id == s.id %}checked{% endif %} data-action="envoi-auto#envoyer">
                                <span class="option-resa__nom">{{ s.nom }}</span>
                                <span class="option-resa__prix">+ {{ s.prixCentimes|euros }}{% if s.dureeMinutes > 0 %} · + {{ s.dureeMinutes|duree }}{% endif %}</span>
                                {% if s.description %}<span class="option-resa__description">{{ s.description }}</span>{% endif %}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <button type="submit" class="bouton bouton--secondaire bouton--compact" data-envoi-auto-target="bouton">Mettre à jour les créneaux</button>
            </form>
        {% endif %}

        {# Le changement de jour ne recharge que ce cadre (Turbo Frame). #}
        <turbo-frame id="creneaux" data-turbo-action="advance">
            <h2 class="visuellement-cache">Jour</h2>
            <ul class="jours" aria-label="Jours disponibles">
                {% for date, creneaux in creneaux_par_jour %}
                    {% set jour_date = date(date) %}
                    <li>
                        {% if creneaux is empty %}
                            <span class="jour jour--complet" aria-disabled="true">
                                <span class="jour__nom">{{ jour_date|date_fr('EEE') }}</span>
                                <span class="jour__numero">{{ jour_date|date_fr('d') }}</span>
                                <span class="jour__mois">{{ jour_date|date_fr('MMM') }}</span>
                                <span class="visuellement-cache">, aucun créneau</span>
                            </span>
                        {% else %}
                            <a class="jour" href="{{ path('app_reservation_creneau', {id: prestation.id, jour: date}|merge(parametres_supplement)) }}"
                               {% if date == jour %}aria-current="date"{% endif %}>
                                <span class="jour__nom">{{ jour_date|date_fr('EEE') }}</span>
                                <span class="jour__numero">{{ jour_date|date_fr('d') }}</span>
                                <span class="jour__mois">{{ jour_date|date_fr('MMM') }}</span>
                            </a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% set creneaux = creneaux_par_jour[jour] ?? [] %}
            <h2 class="creneaux__titre">{{ date(jour)|date_fr('EEEE d MMMM')|capitalize }}</h2>
            {% if creneaux_par_jour|filter(c => c is not empty) is empty %}
                <p>Aucun créneau libre sur les {{ creneaux_par_jour|length }} prochains jours pour cette prestation.
                    <a href="{{ path('app_infos') }}#contact" data-turbo-frame="_top">Contactez-moi</a> pour trouver une solution.</p>
            {% elseif creneaux is empty %}
                <p>Aucun créneau libre ce jour-là. Choisissez un autre jour.</p>
            {% else %}
                {% for moment, filtre in {'Matin': 'matin', 'Après-midi': 'apres-midi'} %}
                    {% set liste = creneaux|filter(c => (c|date('G') < 12) == (filtre == 'matin')) %}
                    {% if liste is not empty %}
                        <h3 class="creneaux__moment">{{ moment }}</h3>
                        <ul class="creneaux">
                            {% for creneau in liste %}
                                <li>
                                    <a class="creneau" data-turbo-frame="_top"
                                       href="{{ path('app_reservation_recapitulatif', {id: prestation.id, creneau: creneau|date(format_creneau)}|merge(parametres_supplement)) }}">
                                        {{ creneau|heure }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </turbo-frame>
    </div>
{% endblock %}
