{% extends 'emails/_base.html.twig' %}
{% block contenu %}
    <p>Bonjour {{ client.prenom }},</p>
    {% if evenement == 'accordee' %}
        <p>Merci pour votre fidélité ! Vous avez cumulé assez de points pour devenir <strong>cliente VIP</strong> :
            <strong>{{ pourcentage }} % de réduction à vie</strong> sur toutes vos prestations.</p>
        <p>Elle s'applique d'office quand vous réservez avec votre compte, et vous ne la perdez jamais.
            Chaque année où vous venez au moins <strong>{{ visites_requises }} fois</strong>, elle augmente, jusqu'à {{ plafond }} %.</p>
    {% elseif evenement == 'renouvelee' %}
        <p>Une année de plus à vos côtés : votre réduction VIP passe à <strong>{{ pourcentage }} %</strong>. Merci !</p>
    {% else %}
        <p>Votre bilan VIP aura lieu le <strong>{{ echeance|date_fr('d MMMM yyyy') }}</strong>.
            Il vous manque <strong>{{ manquants }} rendez-vous</strong> d'ici là pour passer à <strong>{{ pourcentage }} % de réduction</strong>.</p>
        <p>Pas d'inquiétude : quoi qu'il arrive, vous gardez votre statut VIP et votre réduction actuelle.</p>
    {% endif %}
    <p style="margin:20px 0;">
        <a href="{{ url('app_reservation') }}" style="display:inline-block;padding:12px 22px;border-radius:999px;background:#7a4747;color:#ffffff;text-decoration:none;font-weight:bold;">Réserver un rendez-vous</a>
    </p>
    <p style="font-size:13px;color:#6f625e;"><a href="{{ url('app_compte_fidelite') }}" style="color:#7a4747;">Voir ma fidélité</a></p>
{% endblock %}
