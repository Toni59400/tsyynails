{% extends 'base.html.twig' %}

{% block meta %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
    <main class="auth">
        <div class="auth__carte">
            <p class="auth__marque">Tsyynails</p>
            {% for message in app.flashes('success') %}
